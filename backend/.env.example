# Veridian IT Copilot - Backend Environment Configuration

# Server Settings
APP_NAME="Veridian IT Copilot API"
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Temporal Context (Data Pack Grounding)
SIMULATION_BASE_DATE="2026-09-21T09:00:00Z"

# AI Provider Configuration
# Supported options: 'mock', 'openai', 'gemini'
LLM_PROVIDER=mock

# Optional External API Keys (Only needed if LLM_PROVIDER is not 'mock')
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Database Settings
DATABASE_URL=sqlite:///./veridian_it.db

# Knowledge Base & Ground Truth Paths
POLICIES_PATH=../data/policies/knowledge_base.json
REQUESTS_PATH=../data/employee_requests/requests.json
TICKETS_PATH=../data/tickets/seed_tickets.json
